# 虚拟环境
.venv/

# Python 缓存
__pycache__/
*.pyc

# 运行时数据：记忆/对话/决策日志/归档/画图/作品集（隐私 + 自动生成，不入库；程序会自动重建 data/）
data/

# 本地模型权重（SDXL base 等，几个 GB，license 不适用于分发）
models/

# 日志
*.log

# ruff 缓存
.ruff_cache/

# 冒烟测试的临时数据目录（脚本自建自清，不入库）
data_test_*/

# 本地读物（read/ 里是你喂给她的 .md/.docx，个人内容不入库）
read/

# IDE / 编辑器本地数据
.codebuddy/
.vscode/

# ---- 开源边界：以下内容只留本地，不进公开仓库 ----
# 与 publish.py 的排除清单保持一致（两处规则必须同步改，否则脱敏就形同虚设）

# 内部设计决策记录与调研文档（含私人决策过程与本机运行数据）
设计思路/
research_*.md

# 脱敏脚本本身：里面写着脱敏规则原文，公开等于把要脱敏的东西说出来
publish.py

# 注：AGENTS.md 与 air.vbs 已精简/改造为可公开版本（不含私人称呼与本机路径），
# 现在跟代码一起发布——改回去之前先确认它们没有重新长出私人内容。

